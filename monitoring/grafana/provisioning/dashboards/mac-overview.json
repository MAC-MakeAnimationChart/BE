{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["mac", "projectmac"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MAC Overview",
  "uid": "mac-overview",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "상태 (Overview)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "type": "stat",
      "title": "앱 상태 (UP)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "up{job=\"projectmac\"}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "up" }
      ]
    },
    {
      "type": "stat",
      "title": "요청 처리율 (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"projectmac\"}[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "req/s" }
      ]
    },
    {
      "type": "stat",
      "title": "5xx 에러율 (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.001 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"projectmac\",status=~\"5..\"}[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "5xx/s" }
      ]
    },
    {
      "type": "stat",
      "title": "평균 응답시간 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "1000 * sum(rate(http_server_requests_seconds_sum{job=\"projectmac\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"projectmac\"}[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "avg ms" }
      ]
    },
    {
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "요청 처리율 (상태코드별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"projectmac\"}[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "응답시간 (평균 / 최대, URI별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"projectmac\"}[1m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"projectmac\"}[1m]))", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "avg {{uri}}" },
        { "refId": "B", "expr": "max by (uri) (http_server_requests_seconds_max{job=\"projectmac\"})", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "max {{uri}}" }
      ]
    },
    {
      "type": "row",
      "title": "JVM / DB",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "JVM Heap 메모리",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"projectmac\",area=\"heap\"})", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "used" },
        { "refId": "B", "expr": "sum(jvm_memory_committed_bytes{job=\"projectmac\",area=\"heap\"})", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "committed" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU 사용률",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage{job=\"projectmac\"}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "process" },
        { "refId": "B", "expr": "system_cpu_usage{job=\"projectmac\"}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "system" }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션 (HikariCP)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{job=\"projectmac\"}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_idle{job=\"projectmac\"}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "idle" },
        { "refId": "C", "expr": "hikaricp_connections_pending{job=\"projectmac\"}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "pending" }
      ]
    },
    {
      "type": "row",
      "title": "로그 (Loki)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103,
      "panels": []
    },
    {
      "type": "logs",
      "title": "애플리케이션 로그 (app=projectmac)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        { "refId": "A", "expr": "{app=\"projectmac\"}", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "로그 발생량 (레벨별)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
      "id": 11,
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (count_over_time({app=\"projectmac\"}[1m]))", "datasource": { "type": "loki", "uid": "loki" }, "legendFormat": "{{level}}" }
      ]
    }
  ]
}
