@baseUrl = http://localhost:8080
@projectId = 1

### 추후 로그인 기능 연동용
# 로그인 API가 ACCESS_TOKEN, REFRESH_TOKEN을 Set-Cookie로 내려주면
# HTTP Client가 같은 host의 다음 요청에 쿠키를 자동으로 함께 보낸다.
# 실제 auth API 확정 후 path/body만 프로젝트 컨벤션에 맞게 수정한다.
POST {{baseUrl}}/api/v1/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password"
}

### 차트 옵션 최초 생성
POST {{baseUrl}}/api/v1/projects/{{projectId}}/chart-option
Accept: application/json
Content-Type: application/json

{
  "chartType": "BAR"
}

### 차트 옵션 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/chart-option
Accept: application/json

### 차트 옵션 저장/수정
PUT {{baseUrl}}/api/v1/projects/{{projectId}}/chart-option
Accept: application/json
Content-Type: application/json

{
  "chartType": "BAR",
  "dataMapping": {
    "xAxis": "month",
    "yAxis": ["sales"],
    "groupBy": "region"
  },
  "styleOption": {
    "title": "월별 매출 차트",
    "width": 900,
    "height": 520,
    "legend": {
      "visible": true,
      "position": "right"
    },
    "xAxis": {
      "label": "월"
    },
    "yAxis": {
      "label": "매출"
    },
    "colors": ["#4F46E5", "#06B6D4"]
  }
}

### 추후 개발 예정 차트 타입도 백엔드 등록 허용
POST {{baseUrl}}/api/v1/projects/{{projectId}}/chart-option
Accept: application/json
Content-Type: application/json

{
  "chartType": "SCATTER"
}

### 지원하지 않는 차트 타입
POST {{baseUrl}}/api/v1/projects/{{projectId}}/chart-option
Accept: application/json
Content-Type: application/json

{
  "chartType": "bar"
}
