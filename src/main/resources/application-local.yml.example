# 이 파일을 복사해서 application-local.yml 로 이름을 바꾸고 사용하세요.
# application-local.yml 은 .gitignore 에 포함되어 있어 git 에 올라가지 않습니다.
#
# 로컬 실행 전 필요한 것:
#   1. Docker Desktop 설치
#   2. 아래 명령어로 MySQL, Redis 컨테이너 실행
#
#   docker run -d -p 3306:3306 -e MYSQL_ROOT_PASSWORD=1234 -e MYSQL_DATABASE=projectmac --name mac-mysql mysql:8
#   docker run -d -p 6379:6379 --name mac-redis redis
#
# 실행: ./gradlew bootRun
# 접속: http://localhost:8080/swagger-ui/index.html

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/projectmac?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password: 1234
  jpa:
    hibernate:
      ddl-auto: create-drop
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
  flyway:
    enabled: false
  data:
    redis:
      host: localhost
      port: 6379

cors:
  allowed-origins: "http://localhost:3000"

jwt:
  secret: local-dev-secret-key-minimum-32-characters!!
